// Callback-Route für die Discord OAuth2-Weiterleitung
app.get('/callback', async (req, res) => {
  const code = req.query.code;
  const guildId = req.query.state;

  if (!code) return res.send('Kein Code angegeben.');

  try {
    const tokenResponse = await fetch('https://discord.com/api/oauth2/token', {
      method: 'POST',
      body: new URLSearchParams({
        client_id: CONFIG.CLIENT_ID,
        client_secret: CONFIG.CLIENT_SECRET,
        grant_type: 'authorization_code',
        code: code,
        redirect_uri: CONFIG.REDIRECT_URI
      }),
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
    }).then(r => r.json());

    const userResponse = await fetch('https://discord.com/api/users/@me', {
      headers: { authorization: `${tokenResponse.token_type} ${tokenResponse.access_token}` }
    }).then(r => r.json());

    db.run(`INSERT OR REPLACE INTO users (user_id, access_token, refresh_token) VALUES (?, ?, ?)`,
      [userResponse.id, tokenResponse.access_token, tokenResponse.refresh_token]
    );

    if (guildId) {
      db.get(`SELECT * FROM server_settings WHERE guild_id = ?`, [guildId], async (err, settings) => {
        if (settings) {
          const guild = await client.guilds.fetch(guildId).catch(() => null);
          if (guild) {
            const member = await guild.members.fetch(userResponse.id).catch(() => null);
            if (member) {
              if (settings.unverified_role_id) await member.roles.remove(settings.unverified_role_id).catch(() => {});
              if (settings.verified_role_id) await member.roles.add(settings.verified_role_id).catch(() => {});
            }
          }
        }
      });
    }

    res.send('Du wurdest erfolgreich verifiziert! Du kannst dieses Fenster jetzt schließen.');
  } catch (error) {
    console.error(error);
    res.status(500).send('Fehler bei der Verifizierung.');
  }
});

app.listen(CONFIG.PORT, () => console.log(`Webserver & Webseite laufen auf Port ${CONFIG.PORT}`));
client.login(CONFIG.BOT_TOKEN);
