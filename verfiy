require('dotenv').config();
const { Client, GatewayIntentBits, SlashCommandBuilder, PermissionFlagsBits, REST, Routes } = require('discord.js');
const express = require('express');
const sqlite3 = require('sqlite3').verbose();

const CONFIG = {
  BOT_TOKEN: process.env.BOT_TOKEN,
  CLIENT_ID: process.env.CLIENT_ID,
  CLIENT_SECRET: process.env.CLIENT_SECRET,
  REDIRECT_URI: process.env.REDIRECT_URI || 'http://localhost:3000/callback',
  ALLOWED_USER_ID: process.env.ALLOWED_USER_ID,
  PORT: process.env.PORT || 3000
};

// Datenbank-Setup
const db = new sqlite3.Database('./database.sqlite');
db.serialize(() => {
  db.run(`CREATE TABLE IF NOT EXISTS server_settings (
    guild_id TEXT PRIMARY KEY,
    verified_role_id TEXT,
    unverified_role_id TEXT
  )`);
  db.run(`CREATE TABLE IF NOT EXISTS users (
    user_id TEXT PRIMARY KEY,
    access_token TEXT,
    refresh_token TEXT
  )`);
});

const client = new Client({
  intents: [GatewayIntentBits.Guilds, GatewayIntentBits.GuildMembers]
});

// Helper: Not-Verified Rolle bei allen Kanälen sperren
async function setupUnverifiedRolePermissions(guild, roleId) {
  const channels = await guild.channels.fetch();
  channels.forEach(async (channel) => {
    if (channel) {
      await channel.permissionOverwrites.edit(roleId, {
        ViewChannel: false
      }).catch(console.error);
    }
  });
}

// Event: Bot tritt neuem Server bei
client.on('guildCreate', async (guild) => {
  try {
    const verifiedRole = await guild.roles.create({ name: 'Verified', reason: 'Auto-Verification System' });
    const unverifiedRole = await guild.roles.create({ name: 'Not Verified', reason: 'Auto-Verification System' });

    db.run(
      `INSERT OR REPLACE INTO server_settings (guild_id, verified_role_id, unverified_role_id) VALUES (?, ?, ?)`,
      [guild.id, verifiedRole.id, unverifiedRole.id]
    );

    await setupUnverifiedRolePermissions(guild, unverifiedRole.id);
  } catch (err) {
    console.error('Fehler beim automatischen Erstellen der Rollen:', err);
  }
});

// Slash Commands Registrierung
const commands = [
  new SlashCommandBuilder()
    .setName('select-verified-role')
    .setDescription('Ändere die Verified Rolle')
    .addRoleOption(option => option.setName('role').setDescription('Die neue Verified Rolle').setRequired(true))
    .setDefaultMemberPermissions(PermissionFlagsBits.Administrator),

  new SlashCommandBuilder()
    .setName('select-not-verified-role')
    .setDescription('Ändere die Not-Verified Rolle und wende Berechtigungen an')
    .addRoleOption(option => option.setName('role').setDescription('Die neue Not-Verified Rolle').setRequired(true))
    .setDefaultMemberPermissions(PermissionFlagsBits.Administrator),

  new SlashCommandBuilder()
    .setName('pull-members')
    .setDescription('Pullt verifizierte Mitglieder auf einen Server')
    .addStringOption(option => option.setName('target_guild_id').setDescription('ID des Ziel-Servers').setRequired(true))
    .addIntegerOption(option => option.setName('amount').setDescription('Anzahl der Mitglieder (leer lassen für alle)'))
].map(cmd => cmd.toJSON());

const rest = new REST({ version: '10' }).setToken(CONFIG.BOT_TOKEN);

client.once('ready', async () => {
  console.log(`Bot ist online als ${client.user.tag}`);
  await rest.put(Routes.applicationCommands(CONFIG.CLIENT_ID), { body: commands });
});

// Slash Commands Handler
client.on('interactionCreate', async (interaction) => {
  if (!interaction.isChatInputCommand()) return;

  const { commandName, guild, options } = interaction;

  // /select-verified-role
  if (commandName === 'select-verified-role') {
    const role = options.getRole('role');
    db.run(`UPDATE server_settings SET verified_role_id = ? WHERE guild_id = ?`, [role.id, guild.id]);
    return interaction.reply({ content: `Verified Rolle wurde auf <@&${role.id}> gesetzt.`, ephemeral: true });
  }

  // /select-not-verified-role
  if (commandName === 'select-not-verified-role') {
    await interaction.deferReply({ ephemeral: true });
    const role = options.getRole('role');
    
    db.run(`UPDATE server_settings SET unverified_role_id = ? WHERE guild_id = ?`, [role.id, guild.id]);
    await setupUnverifiedRolePermissions(guild, role.id);

    return interaction.editReply({ content: `Not-Verified Rolle auf <@&${role.id}> gesetzt und Kanalberechtigungen angepasst.` });
  }

  // /pull-members
  if (commandName === 'pull-members') {
    if (interaction.user.id !== CONFIG.ALLOWED_USER_ID) {
      return interaction.reply({ content: 'Du hast keine Berechtigung, diesen Befehl auszuführen.', ephemeral: true });
    }

    const targetGuildId = options.getString('target_guild_id');
    const amount = options.getInteger('amount');

    const targetGuild = await client.guilds.fetch(targetGuildId).catch(() => null);
    if (!targetGuild) {
      return interaction.reply({ content: 'Zielserver nicht gefunden oder Bot ist nicht auf dem Server.', ephemeral: true });
    }

    await interaction.deferReply({ ephemeral: true });

    let query = 'SELECT * FROM users';
    if (amount) query += ` LIMIT ${amount}`;

    db.all(query, [], async (err, rows) => {
      if (err || !rows.length) {
        return interaction.editReply({ content: 'Keine verifizierten User in der Datenbank gefunden.' });
      }

      let pulledCount = 0;
      for (const row of rows) {
        try {
          await targetGuild.members.add(row.user_id, { accessToken: row.access_token });
          pulledCount++;
        } catch (e) {
          console.error(`Fehler beim Pullen von User ${row.user_id}:`, e.message);
        }
      }

      return interaction.editReply({ content: `Erfolgreich ${pulledCount} von ${rows.length} Mitgliedern gepullt.` });
    });
  }
});

